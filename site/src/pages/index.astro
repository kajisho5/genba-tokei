---
import "@/styles/global.css";
import FeatureIcon from "@/components/FeatureIcon.astro";
import HeroPhone from "@/components/HeroPhone";
import IslandDemo from "@/components/IslandDemo";
import LandscapeClock from "@/components/LandscapeClock";
import LiveClock from "@/components/LiveClock";
import { features, operatorUses, repoUrl, steps } from "@/content/site";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const title = "現場時計 ― 1/100秒まで、現場の全員が同じ時刻。";
const description =
  "iPhone・iPad・Apple Watch 用の現場時計。ネットの正確な時刻に合わせて端末のずれを補正し、Dynamic Island や小窓にも表示します。";
const nav = [
  { href: "#features", label: "特長" },
  { href: "#demo", label: "デモ" },
  { href: "#status", label: "開発状況" },
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0d10" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="min-h-dvh overflow-x-hidden font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-bg">本文へ移動</a>

    <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-[1248px] items-center gap-6 px-4 sm:px-6 lg:px-12">
        <a href={base} class="flex items-center gap-2.5 text-lg font-bold">
          <span class="size-3 rounded-full bg-accent" aria-hidden="true"></span>現場時計
        </a>
        <nav class="ml-auto hidden items-center gap-7 text-[15px] text-sub md:flex" aria-label="ページ内">
          {nav.map((n) => <a href={n.href} class="hover:text-text">{n.label}</a>)}
          <a href={repoUrl} class="hover:text-text">GitHub</a>
        </nav>
        <span class="hidden rounded-full border border-accent px-4 py-1.5 text-sm font-semibold text-accent md:inline-block" aria-disabled="true">
          TestFlight（準備中）
        </span>
        <details class="relative ml-auto md:hidden">
          <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-lg [&::-webkit-details-marker]:hidden" aria-label="メニュー">
            <svg width="22" height="18" viewBox="0 0 22 18" aria-hidden="true"><rect width="22" height="2.5" rx="1" fill="#F5F7FA" /><rect y="7.5" width="22" height="2.5" rx="1" fill="#F5F7FA" /><rect y="15" width="22" height="2.5" rx="1" fill="#F5F7FA" /></svg>
          </summary>
          <nav class="absolute right-0 top-12 flex w-48 flex-col rounded-2xl border border-border bg-surface p-2 text-[15px]" aria-label="ページ内">
            {nav.map((n) => <a href={n.href} class="rounded-lg px-3 py-3 hover:bg-[#2A2F37]">{n.label}</a>)}
            <a href={repoUrl} class="rounded-lg px-3 py-3 hover:bg-[#2A2F37]">GitHub</a>
            <span class="px-3 py-3 text-accent">TestFlight（準備中）</span>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <!-- ヒーロー -->
      <section class="mx-auto grid max-w-[1248px] items-center gap-12 px-4 pb-20 pt-12 sm:px-6 md:grid-cols-[1fr_auto] md:pt-16 lg:px-12">
        <div>
          <p class="text-sm font-semibold text-accent sm:text-base">iPhone ・ iPad ・ Apple Watch 用の現場時計</p>
          <h1 class="mt-5 text-[clamp(2rem,5.4vw,3.6rem)] font-extrabold leading-[1.3] tracking-tight">
            1/100秒まで、<br />現場の全員が<wbr />同じ時刻。
          </h1>
          <p class="mt-6 max-w-[34em] text-[15px] leading-relaxed text-sub sm:text-lg">
            ネットの正確な時刻に合わせて、端末のずれを自動で補正。<br class="hidden sm:inline" />
            Dynamic Island にも、他のアプリの上の小窓にも出せます。
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#demo" class="flex min-h-13 items-center justify-center rounded-2xl bg-accent px-8 text-base font-bold text-bg hover:brightness-110">デモを試す ↓</a>
            <a href={repoUrl} class="flex min-h-13 items-center justify-center rounded-2xl border border-border bg-surface px-8 text-base font-semibold hover:border-sub">GitHub を見る</a>
          </div>
          <div class="mt-10">
            <LiveClock client:only="react" />
          </div>
        </div>
        <div>
          <HeroPhone client:only="react" />
          <p class="mt-4 text-center text-xs text-faint">上の黒い部分（島）はブラウザ上の再現です</p>
        </div>
      </section>

      <!-- デモ -->
      <section id="demo" class="scroll-mt-16 bg-band px-4 py-20 sm:px-6">
        <h2 class="text-center text-[clamp(1.4rem,3.6vw,2.1rem)] font-extrabold">Dynamic Island の動きを試す</h2>
        <p class="mx-auto mb-10 mt-3 max-w-[40em] text-balance text-center text-sm text-sub sm:text-base">
          ボタンを押すと島の表示が切り替わります。島を長押しすると展開します。
        </p>
        <IslandDemo client:only="react" />
      </section>

      <!-- 特長 -->
      <section id="features" class="mx-auto max-w-[1248px] scroll-mt-16 px-4 py-20 sm:px-6 lg:px-12">
        <h2 class="text-[clamp(1.5rem,3.6vw,2.1rem)] font-extrabold">特長</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {features.map((f) => (
            <li class="rounded-[20px] border border-border bg-surface p-6 sm:p-7">
              <FeatureIcon name={f.icon} />
              <h3 class="text-lg font-bold sm:text-xl">{f.title}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-sub">{f.lines[0]}<br />{f.lines[1]}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- オペレーター -->
      <section class="bg-band py-20">
        <div class="mx-auto grid max-w-[1248px] items-center gap-10 px-4 sm:px-6 md:grid-cols-2 lg:px-12">
          <div>
            <h2 class="text-[clamp(1.4rem,3.4vw,1.9rem)] font-extrabold">オペレーターのために</h2>
            <ul class="mt-6 space-y-4 text-[15px] leading-relaxed text-sub sm:text-[17px]">
              {operatorUses.map((u) => (
                <li class="flex gap-3"><span class="mt-[0.55em] size-2 shrink-0 rounded-full bg-accent" aria-hidden="true" />{u}</li>
              ))}
            </ul>
          </div>
          <div class="flex justify-center md:justify-end">
            <LandscapeClock client:only="react" />
          </div>
        </div>
      </section>

      <!-- 開発状況 -->
      <section id="status" class="mx-auto max-w-[1248px] scroll-mt-16 px-4 py-20 sm:px-6 lg:px-12">
        <h2 class="text-[clamp(1.4rem,3vw,1.7rem)] font-extrabold">開発状況</h2>
        <ol class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-0">
          {steps.map((s, i) => (
            <li class="flex items-center gap-3">
              {i > 0 && <span class="hidden h-0.5 w-14 bg-border sm:mx-4 sm:block" aria-hidden="true" />}
              <span
                class:list={[
                  "size-4 shrink-0 rounded-full",
                  s.state === "done" && "bg-ok",
                  s.state === "now" && "bg-accent",
                  s.state === "todo" && "border-2 border-faint",
                ]}
                aria-hidden="true"
              />
              <span class:list={["text-[15px]", s.state === "now" ? "font-semibold text-accent" : s.state === "done" ? "text-text" : "text-sub"]}>
                {s.label}
                <span class="sr-only">{s.state === "done" ? "（完了）" : s.state === "now" ? "（進行中）" : "（未着手）"}</span>
              </span>
            </li>
          ))}
        </ol>
      </section>
    </main>

    <footer class="mx-auto max-w-[1248px] px-4 pb-12 sm:px-6 lg:px-12">
      <div class="border-t border-line pt-6 text-xs leading-relaxed text-faint">
        <p>
          島の再現に <a class="underline hover:text-sub" href="https://github.com/opencoredev/islandcn">islandcn</a>（MIT ライセンス）を使用。
          Apple、iPhone、iPad、Apple Watch、Dynamic Island は Apple Inc. の商標です。本ページは Apple と無関係です。
        </p>
      </div>
    </footer>
  </body>
</html>

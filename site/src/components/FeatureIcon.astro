---
interface Props { name: string }
const { name } = Astro.props;
---
<div class="mb-5 flex h-10 items-center" aria-hidden="true">
  {name === "sync" && (
    <span class="flex size-10 items-center justify-center rounded-full bg-[#0F2417]"><span class="size-3 rounded-full bg-ok" /></span>
  )}
  {name === "island" && (
    <span class="relative block h-6 w-10 rounded-full bg-text"><span class="absolute left-2 top-[8.5px] size-[7px] rounded-full bg-ok" /></span>
  )}
  {name === "pip" && (
    <svg width="42" height="32" viewBox="0 0 42 32"><rect x="1.5" y="1.5" width="39" height="29" rx="5" fill="none" stroke="#F5F7FA" stroke-width="2.5" /><rect x="19" y="14" width="18" height="13" rx="2" fill="#FFB020" /></svg>
  )}
  {name === "clock" && (
    <span class="num text-[30px] font-semibold leading-none">56<span class="text-[20px] text-accent">.78</span></span>
  )}
  {name === "countdown" && (
    <svg width="40" height="40" viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" fill="none" stroke="#2A2410" stroke-width="5" /><circle cx="20" cy="20" r="16" fill="none" stroke="#FFD60A" stroke-width="5" stroke-linecap="round" stroke-dasharray="72 101" transform="rotate(-90 20 20)" /></svg>
  )}
  {name === "watch" && (
    <svg width="40" height="44" viewBox="0 0 40 44"><rect x="4" y="2" width="32" height="40" rx="11" fill="none" stroke="#F5F7FA" stroke-width="2.5" /><rect x="10" y="17" width="20" height="3" rx="1.5" fill="#FFB020" /></svg>
  )}
</div>
